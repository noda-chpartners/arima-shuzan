---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import shop from '../assets/images/shop.jpg';
import { mapUrl, site } from '../data/site';
---

<section class="section access" id="access">
  <div class="wrap board">
    <div class="info" data-fade>
      <p class="chip">
        <Icon name="lucide:map-pin" />
        場所
      </p>
      <h2 class="section-title">教室のご案内</h2>
      <dl>
        <div>
          <dt>住所</dt>
          <dd>
            <address>〒{site.postalCode} {site.addressFull}</address>
          </dd>
        </div>
        <div>
          <dt>最寄駅</dt>
          <dd>{site.station}</dd>
        </div>
        <div>
          <dt>電話</dt>
          <dd>
            <a href={`tel:${site.telephoneTel}`}>{site.telephone}</a>
          </dd>
        </div>
      </dl>
      <a
        class="btn btn-ghost"
        href={mapUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="有馬珠算塾の場所を地図アプリで開く"
      >
        <Icon name="lucide:navigation" />
        地図アプリで見る
      </a>
    </div>

    <figure class="polaroid" data-fade>
      <div class="photo">
        <Image
          src={shop}
          alt="川崎市宮前区有馬にある有馬珠算塾の入口"
          widths={[640, 960, 1400]}
          sizes="(max-width: 820px) 100vw, 50vw"
          quality={80}
        />
      </div>
      <figcaption>教室の入口</figcaption>
    </figure>
  </div>
</section>

<section class="contact" id="contact">
  <div class="wrap card" data-fade>
    <p class="chip light">
      <Icon name="lucide:smile" />
      まずは体験
    </p>
    <h2>まずは体験してみませんか？</h2>
    <p>
      そろばんが初めてのお子さまも大歓迎です。<br />
      教室の雰囲気を、実際に手を動かして感じてください。
    </p>
    <a class="phone" href={`tel:${site.telephoneTel}`} aria-label={`${site.name}に電話する ${site.telephone}`}>
      <Icon name="lucide:phone" />
      {site.telephone}
    </a>
    <p class="hours">
      お電話でのお問い合わせは、開塾時間内にお願いいたします。<br />
      {site.openingDays} {site.openingHours}
    </p>
  </div>
</section>

<style>
  .access {
    padding-bottom: 2.5rem;
  }

  .board {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 1.4rem;
    align-items: center;
  }

  .info {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  dl {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    width: 100%;
  }

  dl div {
    padding-bottom: 0.7rem;
    border-bottom: 1px dashed var(--line);
  }

  dt {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--sky-deep);
  }

  dd {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 700;
  }

  address {
    font-style: normal;
  }

  .polaroid {
    margin: 0;
    padding: 0.7rem 0.7rem 0.9rem;
    background: var(--white);
    border-radius: 1.5rem;
    box-shadow: var(--shadow);
  }

  .polaroid .photo {
    aspect-ratio: 16 / 11;
    border-radius: 1rem;
    box-shadow: none;
  }

  .polaroid :global(img) {
    object-position: 28% center;
  }

  figcaption {
    margin-top: 0.7rem;
    text-align: center;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--ink-soft);
  }

  .contact {
    padding: 0 0 clamp(3.5rem, 6vw, 5rem);
    scroll-margin-top: calc(var(--header-h) + 0.8rem);
  }

  .card {
    display: grid;
    justify-items: center;
    max-width: 44rem;
    padding: clamp(1.8rem, 4vw, 2.6rem) 1.4rem;
    text-align: center;
    background: var(--sky-soft);
    border-radius: 2rem;
  }

  .chip.light {
    background: var(--white);
    color: var(--sky-deep);
  }

  .card h2 {
    margin: 0.9rem 0 0.7rem;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 700;
  }

  .card > p {
    color: var(--ink-soft);
  }

  .phone {
    display: flex;
    width: fit-content;
    margin: 1.2rem auto 0.8rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border-radius: 999px;
    background: var(--peach);
    color: var(--white);
    font-size: clamp(1.5rem, 5vw, 2.2rem);
    font-weight: 700;
    box-shadow: 0 12px 24px -12px rgba(255, 138, 106, 0.9);
  }

  .phone :global(svg) {
    width: 0.8em;
    height: 0.8em;
  }

  .hours {
    font-size: 0.9rem;
  }

  @media (max-width: 820px) {
    .board {
      grid-template-columns: 1fr;
    }
  }
</style>
