---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import item01 from '../assets/images/item01.jpg';
import stickerBurst from '../assets/images/1e57fe9c-3ddb-47c1-93d5-60912bb0bf85.png';
import stickerSeal from '../assets/images/44087ab7-f357-440e-afaf-6f7cade4aecf.png';
import { site } from '../data/site';
---

<section class="hero" id="top" data-hero>
  <div class="wrap stage">
    <div class="photo-wrap" data-hero-photo>
      <div class="photo hero-photo">
        <Image
          src={item01}
          alt="川崎市宮前区の有馬珠算塾で、そろばんの練習に取り組む子ども"
          widths={[480, 768, 1080, 1440]}
          sizes="(max-width: 820px) 100vw, 900px"
          quality={80}
          priority
        />
      </div>
      <div class="badge since" data-chip>
        <Image src={stickerSeal} alt="" widths={[180, 260, 360]} sizes="150px" />
        <span>昭和46年から<br />続く教室</span>
      </div>
    </div>

    <div class="bubble" data-hero-bubble>
      <p class="kicker">川崎市宮前区のそろばん教室</p>
      <div class="headline">
        <h1>
          そろばんで
          <em>できた！</em>
          を増やそう
        </h1>
        <div class="badge trial" data-chip>
          <Image src={stickerBurst} alt="" widths={[160, 240, 320]} sizes="140px" />
          <span>体験大歓迎</span>
        </div>
      </div>
      <p class="lead">
        計算力は、算数・数学の基本です。<br />
        そろばんは計算力だけじゃない。集中力・忍耐力・自信を育てます。
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={`tel:${site.telephoneTel}`}>
          <Icon name="lucide:phone" />
          体験してみる
        </a>
        <a class="btn btn-ghost" href="#guide">通い方を見る</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: calc(var(--header-h) + 1.4rem) 0 3rem;
  }

  .stage {
    position: relative;
    max-width: 920px;
  }

  .photo-wrap {
    position: relative;
  }

  .hero-photo {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 2rem;
  }

  .badge {
    position: absolute;
    z-index: 3;
    display: grid;
    place-items: center;
    pointer-events: none;
    filter: drop-shadow(0 10px 14px rgba(58, 58, 58, 0.22));
  }

  .badge :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .badge span {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.04em;
  }

  .trial {
    position: relative;
    width: 7.6rem;
    margin: -0.4rem -0.6rem 0 0;
    rotate: -10deg;
    flex-shrink: 0;
  }

  .trial span {
    color: #6b3f12;
    font-size: 0.84rem;
    padding: 0 1.15rem;
  }

  .since {
    right: -0.3rem;
    top: 1.2rem;
    width: 8.8rem;
    rotate: 8deg;
  }

  .since span {
    color: #1f6b56;
    font-size: 0.78rem;
    padding: 0.2rem 1.1rem 0;
  }

  .bubble {
    position: relative;
    z-index: 2;
    overflow: visible;
    width: min(38rem, calc(100% - 1rem));
    margin: -4.2rem auto 0;
    padding: 1.7rem 1.6rem 1.55rem;
    background: var(--white);
    border-radius: 1.8rem;
    box-shadow: 0 22px 40px -24px rgba(43, 134, 166, 0.55);
  }

  .headline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    margin-bottom: 0.85rem;
  }

  .headline h1 {
    margin-bottom: 0;
  }

  .kicker {
    display: inline-block;
    margin-bottom: 0.7rem;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: var(--sky-soft);
    color: var(--sky-deep);
    font-size: 0.78rem;
    font-weight: 700;
  }

  h1 {
    display: grid;
    font-size: clamp(1.85rem, 5vw, 2.7rem);
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 0.85rem;
  }

  h1 em {
    width: fit-content;
    font-style: normal;
    color: var(--peach);
    background: var(--peach-soft);
    padding: 0.02em 0.28em;
    border-radius: 0.4em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.2rem;
  }

  @media (max-width: 720px) {
    .hero-photo {
      aspect-ratio: 4 / 3;
      border-radius: 1.5rem;
    }

    .trial {
      width: 6.4rem;
      margin: -0.2rem -0.4rem 0 0;
    }

    .trial span {
      font-size: 0.7rem;
      padding-inline: 0.95rem;
    }

    .since {
      right: -0.15rem;
      top: 0.4rem;
      width: 7.1rem;
    }

    .since span {
      font-size: 0.64rem;
      padding-inline: 0.9rem;
    }

    .bubble {
      width: 100%;
      margin-top: -2.4rem;
      padding: 1.3rem 1.15rem 1.25rem;
    }
  }
</style>
