---
import { Image } from 'astro:assets';
import shop from '../assets/images/shop.jpg';
import still from '../assets/images/soroban-still.jpg';
---

<section class="section history" id="history">
  <div class="wrap board">
    <div class="story" data-fade>
      <p class="year"><time datetime="1971">1971</time></p>
      <p class="year-ja">昭和46年から、この場所で</p>
      <h2 class="section-title">地域の子どもたちと歩んできた珠算塾です。</h2>
      <p>
        昭和46年からこの場所で珠算塾を開塾し、地域の子どもたちの学びを支えてきました。
      </p>
      <p>
        長く通うご家庭、兄妹で通うご家庭、卒業後も顔を出してくれる生徒さん。
        長年の経験を活かし、一人ひとりの成長をサポートします。
      </p>
      <ol class="steps" data-stagger>
        <li><span>1</span>この町で開塾</li>
        <li><span>2</span>一人ひとりに合わせて</li>
        <li><span>3</span>できた！を積み重ねる</li>
      </ol>
    </div>

    <div class="photos" data-fade>
      <div class="photo shop">
        <Image
          src={shop}
          alt="川崎市宮前区有馬にある有馬珠算塾の教室外観"
          widths={[480, 800, 1200]}
          sizes="(max-width: 820px) 100vw, 42vw"
          quality={80}
        />
        <span>教室の入口</span>
      </div>
      <div class="photo still">
        <Image
          src={still}
          alt="有馬珠算塾の机に置かれたそろばん"
          widths={[400, 720]}
          sizes="(max-width: 820px) 70vw, 28vw"
          quality={75}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .board {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(1.5rem, 3vw, 2.2rem);
    overflow: hidden;
    background: var(--white);
    border-radius: 2rem;
    box-shadow: var(--shadow);
  }

  .year {
    font-size: clamp(3.4rem, 8vw, 5.2rem);
    font-weight: 700;
    line-height: 0.9;
    color: var(--sky);
  }

  .year-ja {
    margin: 0.4rem 0 0.8rem;
    color: var(--sky-deep);
    font-weight: 700;
  }

  .story {
    display: grid;
    gap: 0.85rem;
  }

  .story p:not(.year):not(.year-ja) {
    color: var(--ink-soft);
  }

  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  .steps li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem 0.4rem 0.4rem;
    background: var(--sky-soft);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .steps span {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--sky);
    color: var(--white);
    font-size: 0.78rem;
  }

  .photos {
    position: relative;
    min-height: 24rem;
    padding: 0.4rem 0.6rem 1.6rem 0;
  }

  .shop {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 88%;
  }

  .shop :global(img) {
    object-position: 30% center;
  }

  .shop span {
    position: absolute;
    left: 0.8rem;
    bottom: 0.8rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--white);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .still {
    position: absolute;
    right: 0.2rem;
    bottom: 0.2rem;
    width: 52%;
    aspect-ratio: 4 / 3;
    border: 6px solid var(--white);
    rotate: 5deg;
  }

  @media (max-width: 820px) {
    .board {
      grid-template-columns: 1fr;
    }

    .photos {
      min-height: 18rem;
    }

    .shop {
      max-width: 100%;
      aspect-ratio: 4 / 3;
    }
  }
</style>
