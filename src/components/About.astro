---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import item02 from '../assets/images/item02.jpg';

const pillars = [
  {
    icon: 'lucide:target',
    color: 'sky',
    title: '集中力',
    paragraphs: [
      '珠をはじく手と目が、いまこの一問に集中する力を育てます。',
      '落ち着いて勉強する姿勢を身につけてほしいとお考えのご家庭に。',
    ],
  },
  {
    icon: 'lucide:hand-heart',
    color: 'peach',
    title: '忍耐力',
    paragraphs: [
      'くり返す練習のなかで、最後までやりきる粘り強さが身につきます。',
      '検定合格などの目標に向かって、繰り返し練習を積み重ねることも、忍耐力を育てる大切な経験です。',
    ],
  },
  {
    icon: 'lucide:sun',
    color: 'lemon',
    title: '自信',
    paragraphs: [
      'できた瞬間を積み重ねて、学ぶことそのものが好きになっていきます。',
      '日々の練習を積み重ね、検定に合格できたときの喜びは大きな自信につながります。子どもたちは、努力を続ければできるようになるという成功体験を通じて、自分の可能性を実感していきます。',
    ],
  },
];
---

<section class="section about" id="about">
  <div class="wrap">
    <div class="intro" data-fade>
      <p class="chip">
        <Icon name="lucide:sprout" />
        教室のこと
      </p>
      <h2 class="section-title">
        <span class="title-line">そろばん学習を通して、</span>
        <span class="title-line"><span class="phrase">考える力と学ぶ力を</span><span class="phrase">伸ばします。</span></span>
      </h2>
      <p class="lead">
        計算力は算数、数学の基本です。指先と頭を同時に使い、数字を見る・置く・読む体験を重ねるうちに、子どもたちの考える力と学ぶ力が自然と伸びていきます。
      </p>
    </div>

    <ul class="pillars" data-stagger>
      {
        pillars.map((item) => (
          <li class={item.color}>
            <div class="pillar-heading">
              <span class="icon" aria-hidden="true">
                <Icon name={item.icon} />
              </span>
              <h3>{item.title}</h3>
            </div>
            <div class="pillar-copy">
              {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </li>
        ))
      }
    </ul>

    <figure class="scene" data-fade>
      <div class="photo">
        <Image
          src={item02}
          alt="有馬珠算塾の教室でそろばんを学ぶ生徒たち"
          widths={[640, 960, 1400]}
          sizes="(max-width: 820px) 100vw, 920px"
          quality={80}
        />
      </div>
      <figcaption>
        静かな教室に、集中する時間が流れます。<br />
        珠をはじくたびに、<br class="break-sp" />数字が手の感触になります。
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .about {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    background: linear-gradient(180deg, transparent, var(--mint-soft) 18%, var(--mint-soft) 82%, transparent);
  }

  .intro {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
    width: 100%;
    max-width: none;
    margin-bottom: 1.75rem;
    text-align: center;
  }

  .intro .section-title {
    width: 100%;
    max-width: none;
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    text-wrap: initial;
    line-height: 1.5;
  }

  .intro .title-line {
    display: block;
  }

  .intro .phrase {
    display: inline-block;
    white-space: nowrap;
  }

  .intro .lead {
    width: 100%;
    max-width: 48rem;
    line-height: 1.85;
    text-align: left;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2.2rem;
    align-items: stretch;
  }

  .pillars li {
    display: grid;
    align-content: start;
    min-width: 0;
    gap: 1rem;
    padding: 1.4rem 1.2rem 1.35rem;
    background: var(--white);
    border-radius: 1.6rem;
    box-shadow: var(--shadow);
  }

  .pillar-heading {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .pillar-copy {
    display: grid;
    gap: 0.8rem;
    overflow-wrap: anywhere;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    border-radius: 50%;
  }

  .icon :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .sky .icon {
    background: var(--sky-soft);
    color: var(--sky-deep);
  }

  .peach .icon {
    background: var(--peach-soft);
    color: var(--peach);
  }

  .lemon .icon {
    background: var(--lemon);
    color: #8a6200;
  }

  h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
  }

  .pillars p {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .scene {
    position: relative;
    margin: 0;
    padding-bottom: 2.6rem;
  }

  .scene::before {
    content: "";
    position: absolute;
    inset: 1.15rem -0.7rem -1.1rem 1.35rem;
    background: var(--white);
    border-radius: 2.1rem;
    rotate: 2.4deg;
    box-shadow: var(--shadow);
  }

  .scene .photo {
    position: relative;
    z-index: 1;
    aspect-ratio: 16 / 9.4;
    rotate: -1.2deg;
  }

  .scene .photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    position: absolute;
    z-index: 2;
    left: 1.4rem;
    bottom: -1.35rem;
    width: min(28rem, calc(100% - 2.8rem));
    padding: 1rem 1.25rem 1.05rem;
    background: var(--white);
    border-radius: 1.35rem;
    box-shadow: var(--shadow);
    rotate: -2deg;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .break-sp {
    display: none;
  }

  @media (max-width: 820px) {
    .pillars {
      grid-template-columns: 1fr;
    }

    .scene {
      padding-bottom: 0.4rem;
    }

    .scene::before {
      inset: 0.85rem -0.35rem -0.7rem 0.65rem;
    }

    .scene .photo {
      aspect-ratio: 4 / 3;
      rotate: -0.8deg;
    }

    figcaption {
      position: relative;
      left: auto;
      right: auto;
      bottom: auto;
      width: auto;
      margin: -1.7rem 0.55rem 0;
      rotate: -1deg;
      font-size: 0.9rem;
    }

    .break-sp {
      display: block;
    }
  }
</style>
